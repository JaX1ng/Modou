extends SceneTree
func b(x: float) -> String:
	return PackedFloat64Array([x]).to_byte_array().hex_encode()
func _init():
	print("RUN_START ", b(C.RUN_START))
	print("RUN_MAX ", b(C.RUN_MAX))
	print("RUN_ACC ", b(C.RUN_ACC))
	print("GRAV ", b(C.GRAV))
	print("JUMP_V ", b(C.JUMP_V))
	print("JUMP_VX ", b(C.JUMP_VX))
	print("AIR_ACC ", b(C.AIR_ACC))
	print("AIR_DRIFT ", b(C.AIR_DRIFT))
	print("SOFT_PUSH ", b(C.SOFT_PUSH))
	print("BLOCK_WALK ", b(C.BLOCK_WALK))
	print("DIVE_VX ", b(C.DIVE_VX))
	print("DIVE_VZ ", b(C.DIVE_VZ))
	print("TUMBLE_VX ", b(C.TUMBLE_VX))
	print("TUMBLE_VZ ", b(C.TUMBLE_VZ))
	print("KB_DAMP_R ", b(C.KB_DAMP_R))
	print("KB_DAMP_C ", b(C.KB_DAMP_C))
	print("AIR_DRAG_R ", b(C.AIR_DRAG_R))
	print("AIR_DRAG_C ", b(C.AIR_DRAG_C))
	print("AIR_DRAG_CP ", b(C.AIR_DRAG_CP))
	print("GH ", b(C.GH))
	print("QI_PER_HP ", b(C.QI_PER_HP))
	print("DIVE_HOP ", b(C.DIVE_HOP))
	print("DIVE_RIDE ", b(C.DIVE_RIDE))
	print("LEAP_VX ", b(C.LEAP_VX))
	print("STEP_MS ", b(C.STEP_MS))
	quit()

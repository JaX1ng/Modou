; 墨斗 3.0（Godot 版）。说明见 ../src/GODOT.md

config_version=5

[application]

config/name="墨斗"
config/version="3.0.0-alpha.4"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0
boot_splash/bg_color=Color(0.11, 0.07, 0.055, 1)
boot_splash/image="res://assets/img/splash.png"
config/icon="res://assets/img/icon.png"
config/windows_native_icon="res://assets/img/icon.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="Modou"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.9, 0.76, 0.6, 1)
